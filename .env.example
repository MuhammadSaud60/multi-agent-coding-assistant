# Copy this file to ".env" (same folder) and fill in your values.
# The program always reads the .env in the project root.

# Which model provider to use: ollama | gemini | openai | fake
MACA_MODEL_PROVIDER=ollama

# Model name. Leave empty to use the provider default
# (ollama: llama3.2:3b, gemini: gemini-2.0-flash, openai: gpt-4o-mini).
# Use the EXACT name your provider lists, e.g. for Ollama run: ollama list
MACA_MODEL=llama3.2:latest

# API keys (only the one for your chosen provider is needed):
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional: where generated code goes (default: <project root>/generated_project)
# MACA_WORKSPACE=
